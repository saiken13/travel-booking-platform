{
  "name": "travel-booking-server",
  "version": "1.0.0",
  "description": "Travel Booking Platform API Server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --testEnvironment node --forceExit",
    "test:coverage": "jest --coverage --forceExit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@apollo/server": "^4.9.5",
    "express": "^4.18.2",
    "@as-integrations/express4": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "mongoose": "^8.0.3",
    "ioredis": "^5.3.2",
    "axios": "^1.6.2",
    "amadeus": "^8.1.0",
    "graphql": "^16.8.1",
    "uuid": "^9.0.0",
    "morgan": "^1.10.0",
    "body-parser": "^1.20.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.0",
    "@types/body-parser": "^1.19.5",
    "typescript": "^5.3.2",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.11"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.ts"],
    "globals": {
      "ts-jest": {
        "tsconfig": {
          "strict": false
        }
      }
    }
  }
}
